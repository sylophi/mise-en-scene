{
  "name": "@sylophi/mise-physics",
  "version": "0.0.1",
  "description": "Rapier-backed 2D physics for Mise en Scène: bodies, areas, shapes, and raycasts as units in the tree.",
  "license": "MIT",
  "author": "sylophi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylophi/mise-en-scene.git",
    "directory": "physics"
  },
  "homepage": "https://github.com/sylophi/mise-en-scene/tree/main/physics#readme",
  "bugs": {
    "url": "https://github.com/sylophi/mise-en-scene/issues"
  },
  "keywords": [
    "rapier",
    "physics",
    "2d",
    "game"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3"
  },
  "peerDependencies": {
    "@sylophi/mise-core": "workspace:^"
  },
  "devDependencies": {
    "@sylophi/mise-core": "workspace:^"
  }
}
