{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "**/tsconfig.tsbuildinfo",
    "*.md",
    "**/*.md"
  ]
}
