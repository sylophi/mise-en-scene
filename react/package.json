{
  "name": "@sylophi/mise-react",
  "version": "0.0.1",
  "description": "React DOM renderer for Mise en Scène: every entity is a React component. No canvas.",
  "license": "MIT",
  "author": "sylophi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylophi/mise-en-scene.git",
    "directory": "react"
  },
  "homepage": "https://github.com/sylophi/mise-en-scene/tree/main/react#readme",
  "bugs": {
    "url": "https://github.com/sylophi/mise-en-scene/issues"
  },
  "keywords": [
    "react",
    "renderer",
    "game",
    "dom",
    "2d"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "@sylophi/mise-core": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@sylophi/mise-core": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
